     matcher: M,
     bytes: &[u8],
     line_terminator: &[u8],
     range: std::ops::Range<usize>,
     caps: &mut M::Captures,
     dst: &mut Vec<u8>,
     mut append: F,
 ) -> Result<(), M::Error>
