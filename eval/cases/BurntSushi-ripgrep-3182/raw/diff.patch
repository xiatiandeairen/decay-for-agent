-    decomp_builder: Option<grep::cli::DecompressionReaderBuilder>,
+    decomp_builder: grep::cli::DecompressionReaderBuilder,
     matcher: PatternMatcher,
     searcher: grep::searcher::Searcher,
     printer: Printer<W>,
