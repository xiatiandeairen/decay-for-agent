         parse(None, 0, true);
         parse(None, 1, true);
         parse(None, 50, true);
         parse(None, 99, true);
         parse(None, 100, true);
         //
         // - more than 100, rejected
         //
         parse(None, 101, false);
         parse(None, 102, false);
         parse(None, 200, false);
 
         // max_headers is 0, parser will reject any headers
         //
         // - without header, accepted
