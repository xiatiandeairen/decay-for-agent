             disabled()
         } else {
             self
         }
     }
 
     pub(super) fn ensure_not_timed_out(&self) -> crate::Result<()> {
         if let Some(ref shared) = self.shared {
             let locked = shared.lock().unwrap();
             if locked.is_keep_alive_timed_out {
                 return Err(KeepAliveTimedOut.crate_error());
             }
         }
 
         // else
         Ok(())
     }
