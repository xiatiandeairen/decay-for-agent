                         }
                     } else {
                         debug!("trailer header name not found in trailer header: {}", &name);
                     }
                 }
 
                 let mut buf = Vec::new();
                 if title_case_headers {
                     write_headers_title_case(&allowed_trailers, &mut buf);
                 } else {
                     write_headers(&allowed_trailers, &mut buf);
                 }
 
