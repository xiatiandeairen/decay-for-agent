     fn e(pattern: impl AsRef<str>) -> Seq {
         let pattern = pattern.as_ref();
         let hir = regex_syntax::ParserBuilder::new()
             .utf8(false)
             .build()
             .parse(pattern)
             .unwrap();
         Extractor::new().extract_untagged(&hir)
     }
 
     #[allow(non_snake_case)]
     fn E(x: &str) -> Literal {
         Literal::exact(x.as_bytes())
