 #[cfg(test)]
 fn starts_with(needle: &[u8], haystack: &[u8]) -> bool {
     needle.len() <= haystack.len() && needle == &haystack[..needle.len()]
 }
 
 #[cfg(test)]
 fn ends_with(needle: &[u8], haystack: &[u8]) -> bool {
     if needle.len() > haystack.len() {
         return false;
     }
     needle == &haystack[haystack.len() - needle.len()..]
 }
 
