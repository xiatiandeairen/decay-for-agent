     fn add(glob: &str, args: &[&str], cmds: &mut Vec<DecompressionCommand>) {
         let bin = match resolve_binary(Path::new(args[0])) {
             Ok(bin) => bin,
             Err(err) => {
                 log::debug!("{}", err);
                 return;
             }
         };
         cmds.push(DecompressionCommand {
