 impl RegexMatcher {
     pub(crate) fn new(re: Regex) -> RegexMatcher {
         let mut names = HashMap::new();
         for (i, optional_name) in re.capture_names().enumerate() {
             if let Some(name) = optional_name {
                 names.insert(name.to_string(), i);
             }
