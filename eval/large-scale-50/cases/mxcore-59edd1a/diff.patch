+            std::io::copy(&mut input, &mut output)?;
+        }
+        output.sync_all()?;
     }
     fs::rename(tmp_path, output_path)?;
+    for part in results {
+        if let Some(path) = &part.path {
+            let _ = fs::remove_file(path);
+        }
+    }
+    Ok(())
+}
+
+fn validate_part_result(part: &DownloadPart, result: &PartResult) -> Result<()> {
+    if result.index != part.index {
+        return Err(TransferError::non_retryable(
+            TransferErrorCode::InvalidMeta,
+            "download part result index does not match plan",
+        ));
+    }
+    if let Some(expected) = part.size {
+        if result.size != expected {
+            return Err(TransferError::non_retryable(
+                TransferErrorCode::SizeMismatch,
+                "downloaded part size does not match metadata",
+            ));
+        }
+    }
+    Ok(())
+}
+
+fn validate_upload_plan(plan: &crate::UploadPlan, input_size: u64) -> Result<()> {
+    let mut total = 0_u64;
+    for part in &plan.parts {
+        if part.size == 0 && input_size > 0 {
+            return Err(TransferError::non_retryable(
+                TransferErrorCode::InvalidMeta,
+                "upload part size must be greater than zero",
+            ));
+        }
+        if part.offset.saturating_add(part.size) > input_size {
+            return Err(TransferError::non_retryable(
+                TransferErrorCode::InvalidMeta,
+                "upload part range is outside input",
+            ));
+        }
+        total = total.saturating_add(part.size);
+    }
+    if total != input_size {
+        return Err(TransferError::non_retryable(
+            TransferErrorCode::InvalidMeta,
+            "upload plan ranges do not cover input size",
+        ));
+    }
     Ok(())
 }
+
+async fn upload_part_input(input: &UploadInput, part: &crate::UploadPart) -> Result<PartInput> {
+    match input {
+        UploadInput::Path(path) => Ok(PartInput::PathRange {
+            path: path.clone(),
+            offset: part.offset,
+            size: part.size,
+        }),
+        UploadInput::Reader(reader) => Ok(PartInput::Bytes(
+            reader.read_range(part.offset, part.size).await?,
+        )),
+    }
+}
+
+async fn retry_part<F, Fut, T>(config: &TransferConfig, mut op: F) -> Result<T>
+where
+    F: FnMut() -> Fut,
+    Fut: std::future::Future<Output = Result<T>>,
+{
+    let mut attempt = 0_u32;
+    let mut delay = config.retry_initial_delay;
+    loop {
+        match tokio::time::timeout(config.request_timeout, op()).await {
+            Ok(Ok(value)) => return Ok(value),
+            Ok(Err(err)) if err.retryable && attempt < config.max_retries => {
+                tokio::time::sleep(delay).await;
+                delay = (delay * 2).min(config.retry_max_delay);
+                attempt += 1;
+            }
+            Ok(Err(err)) => return Err(err),
+            Err(_) if attempt < config.max_retries => {
+                tokio::time::sleep(delay).await;
+                delay = (delay * 2).min(config.retry_max_delay);
+                attempt += 1;
+            }
+            Err(_) => {
+                return Err(TransferError::new(
+                    TransferErrorCode::Timeout,
+                    "transfer part timed out",
+                ));
+            }
+        }
+    }
+}
+
+fn temp_part_path(output_path: &PathBuf, index: usize) -> PathBuf {
+    PathBuf::from(format!("{}.part-{index}.tmp", output_path.display()))
+}
+
+fn final_tmp_path(output_path: &PathBuf) -> PathBuf {
+    PathBuf::from(format!("{}.tmp", output_path.display()))
+}
+
+fn cleanup_download_parts(output_path: &PathBuf, parts: &[DownloadPart]) {
+    for part in parts {
+        let _ = fs::remove_file(temp_part_path(output_path, part.index));
+    }
+    let _ = fs::remove_file(final_tmp_path(output_path));
+}
