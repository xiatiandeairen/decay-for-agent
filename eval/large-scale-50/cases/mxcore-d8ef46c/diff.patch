-The Rust e2e tests at `crates/platform/core-transport/tests/end_to_end.rs:happy_path_send_recv_shutdown` use an in-memory duplex. From JS we can't share memory, so we use a Node TCP server that mimics the wire protocol (length-prefix + heartbeat + PushReg ack).
-
-- [ ] **Step 8.1: Write `_loopback-server.ts`**
-
-```ts
-import * as net from 'node:net';
-
-/**
- * Minimal mxcore push-server stub:
- * - reads length-prefixed (u32 BE) frames
- * - on first frame (PushReg encrypted blob), responds with a synthetic
- *   PushRegRes packet — caller supplies the bytes via opts.regResponse
- * - echoes any data frame back
- * - responds to 1-byte heartbeat with 1-byte heartbeat
- */
-export interface LoopbackOpts {
-  port: number;
-  regResponse: Buffer;       // bytes to write after first inbound frame
-}
-
-export function startLoopback(opts: LoopbackOpts): Promise<net.Server> {
-  return new Promise((resolve) => {
-    const srv = net.createServer((socket) => {
-      let buf = Buffer.alloc(0);
-      let regSent = false;
-      socket.on('data', (chunk) => {
-        buf = Buffer.concat([buf, chunk]);
-        while (buf.length >= 4) {
-          const len = buf.readUInt32BE(0);
-          if (buf.length < 4 + len) return;
-          const body = buf.subarray(4, 4 + len);
-          buf = buf.subarray(4 + len);
-
-          if (body.length === 1) {
-            // heartbeat — echo
-            const reply = Buffer.alloc(5);
-            reply.writeUInt32BE(1, 0);
-            reply[4] = body[0];
-            socket.write(reply);
-            continue;
-          }
-          if (!regSent) {
-            regSent = true;
-            const out = Buffer.alloc(4 + opts.regResponse.length);
-            out.writeUInt32BE(opts.regResponse.length, 0);
-            opts.regResponse.copy(out, 4);
-            socket.write(out);
-          } else {
-            // echo
-            const out = Buffer.alloc(4 + body.length);
-            out.writeUInt32BE(body.length, 0);
-            body.copy(out, 4);
-            socket.write(out);
-          }
-        }
-      });
-    });
-    srv.listen(opts.port, '127.0.0.1', () => resolve(srv));
-  });
-}
-```
-
