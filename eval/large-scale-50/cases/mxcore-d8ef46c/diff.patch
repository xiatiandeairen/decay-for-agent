+#define MX_REASON_SEND_RESULT_POOR_NETWORK        3161
+#define MX_REASON_SEND_RESULT_NO_NETWORK          3162
+#define MX_REASON_SEND_RESULT_WRONG_MESSAGE       3163
+#define MX_REASON_SEND_RESULT_QUEUE_FULL          3164
+#define MX_REASON_SEND_RESULT_SUCCESS             3165
+
