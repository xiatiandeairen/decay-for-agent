-/// Returned to JS as `{ name: string, payload: object }`. We intentionally
-/// emit a plain serde_json::Value rather than a typed `#[napi(object)]`
-/// so each event variant can keep its own shape without explosion of
-/// TS interfaces. Bindings TS layer maps to a discriminated union.
-pub fn event_to_js(e: TransportEvent) -> (String, Value, Option<Buffer>) {
-    match e {
-        TransportEvent::Connected { addr } => ("connected".into(), json!({ "addr": addr }), None),
-        TransportEvent::Registered { time_ms } => (
-            "registered".into(),
-            json!({ "timeMs": time_ms }),
-            None,
-        ),
-        TransportEvent::Disconnected { reason } => (
-            "disconnected".into(),
-            json!({ "reason": disconnect_reason_to_str(&reason) }),
-            None,
-        ),
-        TransportEvent::FrameReceived(body) => {
-            ("frameReceived".into(), Value::Null, Some(Buffer::from(body)))
-        }
-        TransportEvent::Reconnecting { attempt, delay } => (
-            "reconnecting".into(),
-            json!({ "attempt": attempt, "delayMs": delay.as_millis() as u64 }),
-            None,
-        ),
-        TransportEvent::Anomaly { length } => (
-            "anomaly".into(),
-            json!({ "length": length }),
-            None,
-        ),
-        TransportEvent::Failed(reason) => (
-            "failed".into(),
-            json!({ "reason": failed_reason_to_str(&reason) }),
-            None,
-        ),
-        TransportEvent::Status(state) => (
-            "status".into(),
-            json!({ "state": push_state_to_str(&state) }),
-            None,
-        ),
-        TransportEvent::FrameDropped { reason } => (
-            "frameDropped".into(),
-            json!({ "reason": drop_reason_to_str(&reason) }),
-            None,
-        ),
-        TransportEvent::DialStarted { addrs } => (
-            "dialStarted".into(),
-            json!({ "addrs": addrs }),
-            None,
-        ),
-        TransportEvent::DialFailed { addr, kind } => (
-            "dialFailed".into(),
-            json!({ "addr": addr, "kind": format!("{:?}", kind) }),
-            None,
-        ),
-        TransportEvent::HeartbeatSent => ("heartbeatSent".into(), Value::Null, None),
-        TransportEvent::NetworkAvailabilityChanged { available } => (
-            "networkAvailabilityChanged".into(),
-            json!({ "available": available }),
-            None,
-        ),
-        TransportEvent::PushRegEncoded { json: bytes } => (
-            "pushRegEncoded".into(),
-            Value::Null,
-            Some(Buffer::from(bytes)),
-        ),
-        TransportEvent::PushRegWire { body } => {
-            ("pushRegWire".into(), Value::Null, Some(Buffer::from(body)))
-        }
-        TransportEvent::PushRegZipMeta { ts_ms, zip_len, zip_head } => (
-            "pushRegZipMeta".into(),
-            json!({ "tsMs": ts_ms, "zipLen": zip_len }),
-            Some(Buffer::from(zip_head)),
-        ),
-        TransportEvent::WireTx { body } => {
-            ("wireTx".into(), Value::Null, Some(Buffer::from(body)))
-        }
-        TransportEvent::WireRx { body } => {
-            ("wireRx".into(), Value::Null, Some(Buffer::from(body)))
-        }
-        TransportEvent::AckReceived { ack_id } => (
-            "ackReceived".into(),
-            json!({ "ackId": ack_id }),
-            None,
-        ),
-        // `#[non_exhaustive]` — future variants surface as a benign
-        // `unknown` event so the binding doesn't panic before being
