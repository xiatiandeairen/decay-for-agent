+// ─── REASON_STORAGE_EVENT (3400-3499)  ·  StorageEvent observation reasons ─
+#define MX_REASON_STORAGE_SLOW_QUERY                       3400
+#define MX_REASON_STORAGE_LOCK_WAIT                        3401
+#define MX_REASON_STORAGE_MIGRATION_STARTED                3410
