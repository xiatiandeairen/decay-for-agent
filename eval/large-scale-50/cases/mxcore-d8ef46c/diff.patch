-### 5.4 AppContext
-
-```ts
-type ClientType = 'ios' | 'mac' | 'android' | 'windows';
-
-interface AppContextInit {
-  clientType: ClientType;
-  appId: string; appVersion: string; appBuild: string; appBundle: string;
