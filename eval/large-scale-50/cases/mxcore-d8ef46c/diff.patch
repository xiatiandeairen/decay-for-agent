-### 5.5 PushTransport
-
-```ts
-interface PushAddress { host: string; port: number; ipFamily: 'v4' | 'v6' }
-
-interface PushRegInfo {
-  uid: string; resource: string; deviceId: string;
-  clientType: number;       // 0=ios 1=mac 2=android 3=windows
-  appId: string; protocolVer: number;
-  apiKeyId: string; apiKey: Buffer;
-  pushOs: number; pushToken: string; voipToken: string | null;
-  language: string; timestampMs: bigint;
-  padding: string;          // base64
-}
-
-interface PushTransportOptions {
-  addresses: PushAddress[];
-  initialNetworkAvailable: boolean;
-  preferAddress?: PushAddress;
-  onNeedRegisterInfo: () => PushRegInfo;          // SYNC only (see §6.2)
-  onNeedRandom: (numBytes: number) => Buffer;     // SYNC only
-  backoff?:
-    | { kind: 'r100Constant' }
-    | { kind: 'exponential', initialMs: number, maxMs: number, jitter: number };
-}
-
-class PushTransport {
-  static create(opts: PushTransportOptions): Promise<PushTransport>;
-  sendFrame(body: Buffer): Promise<void>;
-  reconnect(): Promise<void>;
-  forceClose(): Promise<void>;
-  setNetworkAvailable(available: boolean): Promise<void>;
-  shutdown(): Promise<void>;                      // graceful, awaits supervisor join (≤500ms)
-
-  on(ev: 'connected', cb: () => void): this;
-  on(ev: 'registered', cb: (e: { timeMs: bigint }) => void): this;
-  on(ev: 'disconnected', cb: (e: { reason: DisconnectReason }) => void): this;
-  on(ev: 'failed', cb: (e: { reason: FailedReason }) => void): this;
-  on(ev: 'state', cb: (e: { state: PushState }) => void): this;
-  on(ev: 'reconnecting', cb: () => void): this;
-  on(ev: 'anomaly', cb: (e: { length: number }) => void): this;
-  on(ev: 'frameDropped', cb: () => void): this;
-  on(ev: 'dialFailed', cb: (e: { addr: string; kind: string }) => void): this;
-  // additional diagnostic events tracking TransportEvent (#[non_exhaustive])
-}
-
-type DisconnectReason = 'serverDrop' | 'kickedOff' | 'forceClose' | 'shutdown' | 'ioError';
-type FailedReason =
-  | 'overRetryLimit' | 'emptyPushList' | 'busy' | 'idcError'
-  | 'kickedByServer' | 'retryAltKey' | 'needRefreshTs' | 'unknown';
-type PushState = 'idle' | 'preparing' | 'connecting' | 'connected' | 'registered';
-```
