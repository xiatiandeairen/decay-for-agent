-  encryptCBC(plaintext: Buffer): Buffer;
-  decryptCBC(ciphertext: Buffer): Buffer;
-  encryptIM(plaintext: Buffer, sessionKey: Buffer): Buffer;
-  decryptIM(ciphertext: Buffer, sessionKey: Buffer): Buffer;
