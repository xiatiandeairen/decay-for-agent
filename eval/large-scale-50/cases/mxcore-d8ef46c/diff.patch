index 0000000..415b91a
--- /dev/null
+++ b/crates/core-storage/src/diag.rs
@@ -0,0 +1,677 @@
+//! Pool-level diagnostic hooks — file lock + WAL hook + slow-query profile.
+//!
+//! Mirrors R100 [`MXDatabase.swift`](https://github.com/ccz/R100/blob/main/MXIMSDK/Sources/Storage/MXDatabase/Sources/MXDatabase/MXDatabase.swift):
+//! - `:885-921 installWalHook` → [`install_wal_hook`]
+//! - `:113-119, :142-144, :937-1003 setupDiagnostics / reportSlowQuery` →
+//!   [`install_slow_query_profile`] + per-SQL 60s dedupe in
+//!   [`SharedDiag::record_slow`]
+//! - `:1116-1206 acquireFileLock(exclusive:)` → [`FileLock`] +
+//!   [`FileLockGuard`]
+//!
+//! All three hooks share one [`SharedDiag`] context behind an `Arc` so
+//! the per-SQL dedupe map and the `recent_lock_waits` counter feed each
+//! other (R100 reports `recent_lock_waits` alongside slow_query / lock_timeout).
+//!
+//! Lifetime: the `Arc<SharedDiag>` is owned by [`crate::pool::Pool`].
+//! Raw C callbacks (`sqlite3_wal_hook`, `sqlite3_trace_v2`) hold a
+//! `*const SharedDiag` user-data pointer derived from `Arc::as_ptr`;
+//! `Pool::Drop` unregisters the hooks via `sqlite3_wal_hook(.., null)`
+//! / `sqlite3_trace_v2(.., 0)` before the Arc is dropped, so the raw
+//! pointer never outlives its referent.
+//!
+//! Spec: this file is the trigger-site implementation for
+//! `2026-05-06-storage-event-enum.md §3` Anomaly + Observation events
+//! (`SlowQuery` / `LockWait` / `LockTimeout` / `CheckpointFailed`).
+
+use std::collections::HashMap;
+use std::ffi::{c_char, c_int, c_void, CStr};
+use std::fs::{File, OpenOptions};
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicU32, Ordering};
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use fs2::FileExt;
+use rusqlite::ffi;
+use rusqlite::Connection;
+
+use crate::event::{EventSink, QueueKind, StorageEvent};
+use crate::{Error, Result};
+
+// ─────────────────────────────────────────────────────────────────────
+//   Constants
+// ─────────────────────────────────────────────────────────────────────
+
+/// Default acquire timeout for [`FileLock::acquire_exclusive`]. Matches
+/// R100 5 s busy_timeout / flock ceiling.
+pub const DEFAULT_LOCK_TIMEOUT: Duration = Duration::from_secs(5);
+
+/// Once `acquire_exclusive` has been waiting this long, emit
+/// `StorageEvent::LockWait` once. R100 reports `DB| lock_wait` at the
+/// same 500 ms threshold (`MXDatabase.swift:858`).
+pub const LOCK_WAIT_EMIT_MS: u128 = 500;
+
+/// Slow-query threshold. R100 fires `DB| slow_query` at the same value
+/// (`MXDatabase.swift:850`).
+pub const SLOW_QUERY_THRESHOLD_MS: u64 = 500;
+
+/// Per-SQL dedupe window. R100 also throttles 60 s
+/// (`MXDatabase.swift:969`).
+pub const SLOW_QUERY_DEDUPE_SECS: u64 = 60;
+
+/// Frame-count threshold above which the WAL hook fires a PASSIVE
+/// checkpoint. SQLite's built-in autocheckpoint default is also 1000;
+/// we install our own hook so we can both replicate the autocheckpoint
+/// and surface `CheckpointFailed` to bindings. R100 mirrors this
+/// (`MXDatabase.swift:893`).
+pub const WAL_CHECKPOINT_FRAME_THRESHOLD: i32 = 1000;
+
+// ─────────────────────────────────────────────────────────────────────
+//   SharedDiag — context shared by every hook
+// ─────────────────────────────────────────────────────────────────────
+
+/// Per-pool diagnostic context. Cheap-cloned via `Arc`.
+///
+/// Holds the event sink, the slow-query dedupe map, and a counter of
+/// recent flock waits so `LockTimeout` / `SlowQuery` events can attach
+/// `recent_lock_waits` for triage. See module-level docs for lifetime
+/// guarantees against raw C callback user-data.
+pub struct SharedDiag {
+    /// Workspace-relative db path used in every emitted event (I7
+    /// invariant: no user_hash prefix, no absolute path).
+    pub(crate) db_path: String,
+    /// Cloneable sink; `None` ⇒ events are dropped without formatting cost.
+    sink: Option<EventSink>,
+    /// SQL template → (last emit time, suppressed count since last emit).
+    slow_query_dedupe: Mutex<HashMap<String, (Instant, u32)>>,
+    /// Drained by `LockTimeout` (R100 `recent_lock_waits` field).
+    recent_lock_waits: AtomicU32,
+}
+
+impl SharedDiag {
+    /// Build a new shared diag context. Returns an `Arc` because every
+    /// hook (and `Pool` itself) holds one.
+    pub(crate) fn new(db_path: String, sink: Option<EventSink>) -> Arc<Self> {
+        Arc::new(SharedDiag {
+            db_path,
+            sink,
+            slow_query_dedupe: Mutex::new(HashMap::new()),
+            recent_lock_waits: AtomicU32::new(0),
+        })
+    }
+
+    /// Forward an event to the configured sink. `pub(crate)` so
+    /// [`crate::pool::Pool::emit_event`] can funnel its caller-facing
+    /// emits through the same path.
+    pub(crate) fn emit(&self, ev: StorageEvent) {
+        if let Some(s) = self.sink.as_ref() {
+            s(ev);
+        }
+    }
+
+    /// Snapshot + reset the recent-waits counter. Called by
+    /// `acquire_exclusive` when it gives up so the `LockTimeout` event
+    /// carries an accurate "this is the N-th wait recently" signal and
+    /// the next window starts at zero.
+    fn drain_recent_waits(&self) -> u32 {
+        self.recent_lock_waits.swap(0, Ordering::Relaxed)
+    }
+
+    /// Called by the profile callback (raw C pointer, see
+    /// [`profile_callback`]). Applies the 60-s dedupe + suppressed count
+    /// merge then emits `SlowQuery` if appropriate.
+    fn record_slow(&self, sql_template: String, cost_ms: u64, queue: QueueKind) {
+        if cost_ms < SLOW_QUERY_THRESHOLD_MS {
+            return;
+        }
+        let prior_suppressed = {
+            let now = Instant::now();
+            let mut g = match self.slow_query_dedupe.lock() {
+                Ok(g) => g,
+                Err(p) => p.into_inner(),
+            };
+            match g.get_mut(&sql_template) {
+                Some((last, supp))
+                    if now.duration_since(*last).as_secs() < SLOW_QUERY_DEDUPE_SECS =>
+                {
+                    *supp = supp.saturating_add(1);
+                    return; // suppressed
+                }
+                Some((last, supp)) => {
+                    let prior = std::mem::replace(supp, 0);
+                    *last = now;
+                    prior
+                }
+                None => {
+                    g.insert(sql_template.clone(), (now, 0));
+                    0
+                }
+            }
+        };
+        self.emit(StorageEvent::SlowQuery {
+            db_path: self.db_path.clone(),
+            sql_template,
+            cost_ms,
+            queue,
+            params_count: 0, // profile callback doesn't expose bound params; left 0
+            suppressed: prior_suppressed,
+            recent_lock_waits: self.recent_lock_waits.load(Ordering::Relaxed),
+            tx_pos: 0,
+            tx_total: 0,
+            tx_elapsed_ms: 0,
+            since_ckpt_ms: -1, // not tracked yet — wal_hook only counts frames
+        });
+    }
+}
+
+// ─────────────────────────────────────────────────────────────────────
+//   FileLock — advisory cross-process exclusion
+// ─────────────────────────────────────────────────────────────────────
+
+/// Cross-process advisory file lock on `${db_path}.lock`.
+///
+/// Use [`FileLock::open`] once per `Pool` and call
+/// [`FileLock::acquire_exclusive`] before every write transaction (or
+/// migration / keying-rotation step). The returned [`FileLockGuard`]
+/// releases the lock on `Drop`.
+///
+/// Single-process behaviour: the same `Pool` reuses one `fd`, and both
+/// BSD `flock(2)` and Linux `F_OFD_SETLK` treat repeated acquires on the
+/// same fd as no-ops — there is no extra cost for write-heavy workloads
+/// inside one process. The lock only blocks across processes, which is
+/// exactly the iOS main-app ↔ NSE case (`schema.md §1.3`).
+pub struct FileLock {
+    fd: File,
+    lock_path: PathBuf,
+    diag: Arc<SharedDiag>,
+}
+
+impl FileLock {
+    /// Create / open `${db_path}.lock` next to the db file and stash the fd.
+    /// `lock_path_for` is the canonical "<db>.lock" path used regardless
+    /// of whether the db file itself exists yet (Pool::open precedes
+    /// migrations).
+    pub fn open(db_path: &Path, diag: Arc<SharedDiag>) -> Result<Self> {
+        let lock_path = Self::lock_path_for(db_path);
+        let fd = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .truncate(false)
+            .open(&lock_path)
+            .map_err(io_to_sqlite_err)?;
+        Ok(FileLock {
+            fd,
+            lock_path,
+            diag,
+        })
+    }
+
+    /// Compute the on-disk lock path for a given db. Public so tests can
+    /// assert path layout without re-deriving.
+    pub fn lock_path_for(db_path: &Path) -> PathBuf {
+        let mut p = db_path.to_path_buf();
+        let new_name = match db_path.file_name() {
+            Some(f) => {
+                let mut s = f.to_owned();
+                s.push(".lock");
+                s
+            }
+            None => std::ffi::OsString::from(".lock"),
+        };
+        p.set_file_name(new_name);
+        p
+    }
+
+    /// Block until the lock is held exclusively, or `timeout` elapses.
+    ///
+    /// Behaviour:
+    /// - polls `try_lock_exclusive` with 50 ms backoff
+    /// - emits `StorageEvent::LockWait` once after the wait crosses
+    ///   [`LOCK_WAIT_EMIT_MS`] (500 ms) — at most once per acquire
+    /// - emits `StorageEvent::LockTimeout` + returns
+    ///   [`Error::LockTimeout`] when the cumulative wait reaches
+    ///   `timeout`
+    /// - on success returns a [`FileLockGuard`] that releases on `Drop`
+    pub fn acquire_exclusive(&self, timeout: Duration) -> Result<FileLockGuard<'_>> {
+        let started = Instant::now();
+        let mut warned = false;
+        loop {
+            match FileExt::try_lock_exclusive(&self.fd) {
+                Ok(()) => return Ok(FileLockGuard { lock: self }),
+                Err(e) if e.kind() == std::io::ErrorKind::WouldBlock => {
+                    let waited_ms = started.elapsed().as_millis();
+                    if !warned && waited_ms >= LOCK_WAIT_EMIT_MS {
+                        warned = true;
+                        self.diag.recent_lock_waits.fetch_add(1, Ordering::Relaxed);
+                        self.diag.emit(StorageEvent::LockWait {
+                            db_path: self.diag.db_path.clone(),
+                            waited_ms: waited_ms as u64,
+                            exclusive: true,
+                        });
+                    }
+                    if started.elapsed() >= timeout {
+                        let recent = self.diag.drain_recent_waits();
+                        let waited_ms = started.elapsed().as_millis() as u64;
+                        self.diag.emit(StorageEvent::LockTimeout {
+                            db_path: self.diag.db_path.clone(),
+                            waited_ms,
+                            exclusive: true,
+                            recent_lock_waits: recent,
+                        });
+                        return Err(Error::LockTimeout { waited_ms });
+                    }
+                    std::thread::sleep(Duration::from_millis(50));
+                }
+                Err(e) => return Err(io_to_sqlite_err(e)),
+            }
+        }
+    }
+
+    /// Path the lock fd was opened on. Exposed for diagnostics tests.
+    pub fn lock_path(&self) -> &Path {
+        &self.lock_path
+    }
+}
+
+/// RAII guard returned by [`FileLock::acquire_exclusive`]. On `Drop`
+/// calls `flock(LOCK_UN)` (best-effort — a process crash also releases
+/// the lock at fd close time, so unlock failure here is benign).
+#[derive(Debug)]
+pub struct FileLockGuard<'a> {
+    lock: &'a FileLock,
+}
+
+impl std::fmt::Debug for FileLock {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("FileLock")
+            .field("lock_path", &self.lock_path)
+            .finish_non_exhaustive()
+    }
+}
+
+impl Drop for FileLockGuard<'_> {
+    fn drop(&mut self) {
+        let _ = FileExt::unlock(&self.lock.fd);
+    }
+}
+
+fn io_to_sqlite_err(e: std::io::Error) -> Error {
+    // `rusqlite::Error` has no native "io" variant — wrap as
+    // `SqliteFailure(SQLITE_IOERR)` so the error_code mapping still
+    // lands in the storage segment and bindings get a consistent shape.
+    Error::Sqlite(rusqlite::Error::SqliteFailure(
+        ffi::Error::new(ffi::SQLITE_IOERR),
+        Some(format!("flock: {e}")),
+    ))
+}
