-//! Translation layer: mxcore typed errors → `napi::Error`.
-//!
-//! All `napi::Error::reason` values follow the format `"<SYMBOL>(<code>)"`
-//! aligning with `mxcore.h` constants where applicable. Codes outside
-//! `mxcore.h` use a synthetic 1xxx range to avoid collision with the
-//! canonical C ABI numbering documented in `crates/core-ffi/src/lib.rs`.
-
-use core_context::BuildError as CtxBuildError;
-use core_context::SyncOutcome;
-use core_crypto::IKeyError;
-use core_ffi::ingest::IngestError;
-use core_push::handle::SendError;
-
-pub fn ikey_err(e: IKeyError) -> napi::Error {
-    let (sym, code) = match e {
-        IKeyError::InvalidInput => ("MX_ERR_INVALID_INPUT", 1),
-        IKeyError::InvalidBufferSize => ("MX_ERR_INVALID_BUFFER_SIZE", 2),
-        IKeyError::AuthKeyMismatch => ("MX_ERR_AUTH_KEY_MISMATCH", 3),
-        IKeyError::InvalidPadding => ("MX_ERR_INVALID_PADDING", 4),
-        IKeyError::MsgKeyMismatch => ("MX_ERR_MSG_KEY_MISMATCH", 5),
-    };
-    napi::Error::from_reason(format!("{}({})", sym, code))
-}
-
-pub fn ingest_err(_e: IngestError) -> napi::Error {
-    napi::Error::from_reason("MX_ERR_INVALID_INPUT(1)".to_string())
-}
-
-pub fn ctx_build_err(e: CtxBuildError) -> napi::Error {
-    napi::Error::from_reason(format!("MX_ERR_INVALID_INPUT(1): {}", e))
-}
-
-pub fn clock_rejected() -> napi::Error {
-    napi::Error::from_reason("MX_ERR_CLOCK_REJECTED(200)".to_string())
-}
-
-pub fn not_logged_in() -> napi::Error {
-    napi::Error::from_reason("MX_ERR_NOT_LOGGED_IN(201)".to_string())
-}
-
-#[allow(dead_code)] // kept for future transport_events / non-current call sites
-pub fn send_err(e: SendError) -> napi::Error {
-    let sym = match e {
-        SendError::Closed => "MX_ERR_TRANSPORT_CLOSED(100)",
-        SendError::Full => "MX_ERR_TRANSPORT_BUSY(1000)",
-    };
-    napi::Error::from_reason(sym.to_string())
-}
-
-#[allow(dead_code)] // kept; AppContext currently inlines the match
-pub fn sync_outcome_to_result(o: SyncOutcome) -> napi::Result<()> {
-    match o {
-        SyncOutcome::Accepted { .. } => Ok(()),
-        SyncOutcome::Rejected { .. } => Err(clock_rejected()),
-    }
-}
-
-#[cfg(test)]
-mod tests {
-    use super::*;
-
-    #[test]
-    fn ikey_err_message_format() {
-        let e = ikey_err(IKeyError::AuthKeyMismatch);
-        assert!(e.reason.contains("MX_ERR_AUTH_KEY_MISMATCH"));
-        assert!(e.reason.contains("(3)"));
-    }
-
-    #[test]
-    fn clock_rejected_carries_code() {
-        let e = clock_rejected();
-        assert!(e.reason.contains("MX_ERR_CLOCK_REJECTED"));
-        assert!(e.reason.contains("(200)"));
-    }
-
-    #[test]
-    fn not_logged_in_carries_code() {
-        let e = not_logged_in();
-        assert!(e.reason.contains("MX_ERR_NOT_LOGGED_IN"));
-        assert!(e.reason.contains("(201)"));
-    }
-
-    #[test]
-    fn send_err_full_distinct_from_closed() {
-        let a = send_err(SendError::Full).reason;
-        let b = send_err(SendError::Closed).reason;
-        assert_ne!(a, b);
-    }
-
-    #[test]
-    fn sync_outcome_rejected_to_err() {
-        assert!(sync_outcome_to_result(SyncOutcome::Accepted { drift_ms: 0 }).is_ok());
-        assert!(sync_outcome_to_result(SyncOutcome::Rejected {
-            current_ms: 1,
-            attempted_ms: 0,
-        })
-        .is_err());
-    }
-}
