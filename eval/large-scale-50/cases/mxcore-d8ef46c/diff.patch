-## Task 6: ThreadsafeFunction bridge
-
-`PushTransport` requires two synchronous JS callbacks (rng + register-info). napi-rs `ThreadsafeFunction` is fire-and-forget by default; we need a synchronous return path for the tokio worker. This task isolates that bridge so `transport.rs` stays focused.
-
-**Files:**
-- Create: `bindings/electron/src/threadsafe.rs`
-- Modify: `bindings/electron/src/lib.rs`
-
-- [ ] **Step 6.1: Write `bindings/electron/src/threadsafe.rs`**
-
-```rust
-//! Synchronous return-value bridge over `napi::ThreadsafeFunction`.
-//!
-//! mxcore's supervisor calls `RegisterContext::info_fn` and `rng_fn`
-//! synchronously from a tokio worker thread. JS callbacks live on the
-//! V8 main thread. We use `ThreadsafeFunction::call_with_return_value`
-//! plus a `std::sync::mpsc::sync_channel` to round-trip the JS return
-//! value into the worker thread without `block_on`-on-V8 (which would
-//! deadlock).
-//!
-//! Timeout is set to 5s — matching `core_transport::register::DEFAULT_HANDSHAKE_TIMEOUT`.
-//! On timeout the bridge returns an empty `Vec<u8>` for rng (the only
-//! observable failure mode) and a sentinel `PushRegInfo` (uid="") for
-//! info; downstream code maps this to `RegisterOutcome::GarbledResponse`.
-
-use core_protocol::pushreg::{PushOs, PushRegInfo};
-use napi::bindgen_prelude::*;
-use napi::threadsafe_function::{ErrorStrategy, ThreadsafeFunction, ThreadsafeFunctionCallMode};
-use std::sync::mpsc::sync_channel;
-use std::time::Duration;
-
-const SYNC_CALLBACK_TIMEOUT: Duration = Duration::from_secs(5);
-
-/// `(num_bytes: u32) => Buffer` — JS supplies cryptographic randomness.
-pub type RngCallback = ThreadsafeFunction<u32, ErrorStrategy::Fatal>;
-
-/// `() => PushRegInfoJs` — JS supplies the per-dial register payload.
-pub type InfoCallback = ThreadsafeFunction<(), ErrorStrategy::Fatal>;
-
-#[napi(object)]
-pub struct PushRegInfoJs {
-    pub uid: String,
-    pub space_id: String,
-    pub rid: String,
-    pub loc: String,
-    pub network: String,
-    pub device_key: String,
-    pub model: String,
-    pub os: String,                 // "ios" | "mac" | "android" | "windows"
-    pub client_version: String,
-    pub os_version: String,
-    pub is_appex: bool,
-    pub tenant_id: Option<String>,
-}
-
-pub fn js_to_pushreg(js: PushRegInfoJs) -> napi::Result<PushRegInfo> {
-    let os = match js.os.as_str() {
-        "ios" => PushOs::Ios,
-        "mac" => PushOs::Mac,
-        "android" => PushOs::Android,
-        "windows" => PushOs::Windows,
-        other => {
-            return Err(napi::Error::from_reason(format!(
-                "MX_ERR_INVALID_INPUT(1): unknown os `{}`",
-                other
-            )))
-        }
-    };
-    Ok(PushRegInfo {
-        uid: js.uid,
-        space_id: js.space_id,
-        rid: js.rid,
-        loc: js.loc,
-        network: js.network,
-        device_key: js.device_key,
-        model: js.model,
-        os,
-        client_version: js.client_version,
-        os_version: js.os_version,
-        is_appex: js.is_appex,
-        tenant_id: js.tenant_id,
-    })
-}
-
-pub fn empty_info() -> PushRegInfo {
-    PushRegInfo {
-        uid: String::new(),
-        space_id: String::new(),
-        rid: String::new(),
-        loc: String::new(),
-        network: String::new(),
-        device_key: String::new(),
-        model: String::new(),
-        os: PushOs::Windows,
-        client_version: String::new(),
-        os_version: String::new(),
-        is_appex: false,
-        tenant_id: None,
-    }
-}
-
-pub fn call_rng_sync(tsfn: &RngCallback, n: u32) -> Vec<u8> {
-    let (tx, rx) = sync_channel::<Vec<u8>>(0);
-    let status = tsfn.call_with_return_value(
-        n,
-        ThreadsafeFunctionCallMode::Blocking,
-        move |buf: Buffer| {
-            let _ = tx.send(buf.to_vec());
-            Ok(())
-        },
-    );
-    if status != Status::Ok {
-        return Vec::new();
-    }
-    rx.recv_timeout(SYNC_CALLBACK_TIMEOUT).unwrap_or_default()
-}
-
-pub fn call_info_sync(tsfn: &InfoCallback) -> PushRegInfo {
-    let (tx, rx) = sync_channel::<napi::Result<PushRegInfo>>(0);
-    let status = tsfn.call_with_return_value(
-        (),
-        ThreadsafeFunctionCallMode::Blocking,
-        move |js: PushRegInfoJs| {
-            let _ = tx.send(js_to_pushreg(js));
-            Ok(())
-        },
-    );
-    if status != Status::Ok {
-        return empty_info();
-    }
-    rx.recv_timeout(SYNC_CALLBACK_TIMEOUT)
-        .ok()
-        .and_then(|r| r.ok())
-        .unwrap_or_else(empty_info)
-}
-```
