+
+
+// ============================================================================
+//   Segment helpers
+// ============================================================================
+
+// Recover the segment id (0 = FFI / 1 = CRYPTO / ... / 10 = HTTP) from a
+// raw mx_err_t. Returns -1 for OK or out-of-range input. Pair with the
+// constants above for `switch (mx_err_segment(rc))` dispatching.
+static inline int mx_err_segment(mx_err_t code) {
+    return code < 1000 ? -1 : (int)((code - 1000) / 100);
+}
+
+// Recover the segment id (0 = FAILED / 1 = DISCONNECT / 2 = DROP /
+// 3 = PUSH_REG / 4 = STORAGE_EVENT) from a raw mx_reason_t. Returns -1
+// for out-of-range input.
+static inline int mx_reason_segment(mx_reason_t code) {
+    return code < 3000 ? -1 : (int)((code - 3000) / 100);
+}
