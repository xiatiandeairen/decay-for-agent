+// ─────────────────────────────────────────────────────────────────────
+//   WAL hook — sqlite3_wal_hook
+// ─────────────────────────────────────────────────────────────────────
+
+/// Install `sqlite3_wal_hook` on `conn`. The hook runs PASSIVE
+/// checkpoints once frame count crosses
+/// [`WAL_CHECKPOINT_FRAME_THRESHOLD`] and emits
+/// `StorageEvent::CheckpointFailed` if the underlying
+/// `sqlite3_wal_checkpoint_v2` call returns non-OK (other than
+/// `SQLITE_BUSY` PASSIVE-leftover, which is the normal "readers held a
+/// snapshot" case).
+///
+/// `Arc::clone` the diag so the raw C callback can read it via raw
+/// pointer; [`uninstall_wal_hook`] must run before the Arc count drops
+/// to zero — currently it's called from [`crate::pool::Pool::Drop`].
+///
+/// Returns the leaked Arc pointer the caller stashes in `Pool` for
+/// later cleanup.
+///
+/// # Safety
+/// Caller must call [`uninstall_wal_hook`] with the same `conn` and the
+/// returned pointer before the underlying `Connection` is closed.
+pub(crate) unsafe fn install_wal_hook(
+    conn: &Connection,
+    diag: Arc<SharedDiag>,
+) -> *const SharedDiag {
+    let raw = Arc::into_raw(diag);
+    let db = conn.handle();
+    unsafe {
+        ffi::sqlite3_wal_hook(db, Some(wal_hook_trampoline), raw as *mut c_void);
+    }
+    raw
+}
+
+/// Counterpart to [`install_wal_hook`]. Detaches the hook (passing
+/// `null`) and reclaims ownership of the Arc.
+///
+/// # Safety
+/// `raw` must come from a prior `install_wal_hook` call on the same
+/// `conn` and must not have been freed already.
+pub(crate) unsafe fn uninstall_wal_hook(conn: &Connection, raw: *const SharedDiag) {
+    let db = conn.handle();
+    unsafe {
+        ffi::sqlite3_wal_hook(db, None, std::ptr::null_mut());
+        drop(Arc::from_raw(raw));
+    }
+}
+
+unsafe extern "C" fn wal_hook_trampoline(
+    user: *mut c_void,
+    db: *mut ffi::sqlite3,
+    _db_name: *const c_char,
+    n_frame: c_int,
+) -> c_int {
+    if user.is_null() {
+        return ffi::SQLITE_OK;
+    }
+    // SAFETY: pointer was obtained from `Arc::into_raw` and is still
+    // alive because `uninstall_wal_hook` runs before the Arc is dropped.
+    let diag = unsafe { &*(user as *const SharedDiag) };
+    if n_frame >= WAL_CHECKPOINT_FRAME_THRESHOLD {
+        let mut n_log: c_int = -1;
+        let mut n_ckpt: c_int = -1;
+        let rc = unsafe {
+            ffi::sqlite3_wal_checkpoint_v2(
+                db,
+                std::ptr::null(),
+                ffi::SQLITE_CHECKPOINT_PASSIVE,
+                &mut n_log as *mut c_int,
+                &mut n_ckpt as *mut c_int,
+            )
+        };
+        // SQLITE_BUSY here is the normal "reader held a snapshot, only
+        // partial frames reclaimed" case — not an error. Skip emitting
+        // for it; R100 throttles the same way (`MXDatabase.swift:914`).
+        if rc != ffi::SQLITE_OK && rc != ffi::SQLITE_BUSY {
+            let frames_blocked = if n_log >= 0 && n_ckpt >= 0 {
+                n_log - n_ckpt
+            } else {
+                -1
+            };
+            diag.emit(StorageEvent::CheckpointFailed {
+                db_path: diag.db_path.clone(),
+                sqlite_code: rc,
+                n_frame,
+                n_log,
+                n_ckpt,
+                frames_blocked,
+                wal_size: 0, // not cheaply reachable from inside hook
+                disk_free_mb: -1,
+            });
+        }
+    }
+    ffi::SQLITE_OK
+}
+
+// ─────────────────────────────────────────────────────────────────────
+//   Slow-query profile — sqlite3_trace_v2(SQLITE_TRACE_PROFILE)
+// ─────────────────────────────────────────────────────────────────────
+
+/// Install the trace_v2(`SQLITE_TRACE_PROFILE`) callback on `conn`.
+/// Same lifetime contract as [`install_wal_hook`].
+///
+/// `queue` identifies which connection slot this profile belongs to so
+/// the emitted `StorageEvent::SlowQuery` carries the right
+/// [`QueueKind`].
+///
+/// # Safety
+/// Pair every call with [`uninstall_slow_query_profile`] on the same
+/// `conn` before the connection is closed.
+pub(crate) unsafe fn install_slow_query_profile(
+    conn: &Connection,
+    diag: Arc<SharedDiag>,
+    queue: QueueKind,
+) -> *const ProfileSlot {
+    let slot = Box::new(ProfileSlot { diag, queue });
+    let raw = Box::into_raw(slot);
+    let db = conn.handle();
+    unsafe {
+        ffi::sqlite3_trace_v2(
+            db,
+            ffi::SQLITE_TRACE_PROFILE as u32,
+            Some(profile_callback),
+            raw as *mut c_void,
+        );
+    }
+    raw
+}
+
+/// Counterpart to [`install_slow_query_profile`]. Disables tracing then
+/// drops the boxed slot.
+///
+/// # Safety
+/// `raw` must come from `install_slow_query_profile` on the same conn.
+pub(crate) unsafe fn uninstall_slow_query_profile(conn: &Connection, raw: *const ProfileSlot) {
+    let db = conn.handle();
+    unsafe {
+        ffi::sqlite3_trace_v2(db, 0, None, std::ptr::null_mut());
+        drop(Box::from_raw(raw as *mut ProfileSlot));
+    }
+}
+
+/// Per-connection profile context. Each reader / writer connection gets
+/// its own `ProfileSlot` because the `QueueKind` differs (and the
+/// `Arc<SharedDiag>` is cheaply shared).
+pub(crate) struct ProfileSlot {
+    diag: Arc<SharedDiag>,
+    queue: QueueKind,
+}
+
+unsafe extern "C" fn profile_callback(
+    code: u32,
+    user: *mut c_void,
+    p: *mut c_void,
+    x: *mut c_void,
+) -> c_int {
+    if code != ffi::SQLITE_TRACE_PROFILE as u32 || user.is_null() {
+        return 0;
+    }
+    // SAFETY: `user` came from `Box::into_raw` and is still owned by us
+    // until `uninstall_slow_query_profile`.
+    let slot = unsafe { &*(user as *const ProfileSlot) };
+    // `p` = sqlite3_stmt*, `x` = *const i64 (nanoseconds). See
+    // https://sqlite.org/c3ref/c_trace.html#sqlitetraceprofile.
+    let stmt = p as *mut ffi::sqlite3_stmt;
+    if stmt.is_null() || x.is_null() {
+        return 0;
+    }
+    let ns: i64 = unsafe { *(x as *const i64) };
+    let cost_ms = (ns / 1_000_000) as u64;
+    if cost_ms < SLOW_QUERY_THRESHOLD_MS {
+        return 0;
+    }
+    let sql_ptr = unsafe { ffi::sqlite3_sql(stmt) };
+    let template = if sql_ptr.is_null() {
+        "(unknown)".to_string()
+    } else {
+        // SAFETY: SQLite owns this string for the lifetime of the
+        // statement; copying it into an owned String detaches us.
+        let cstr = unsafe { CStr::from_ptr(sql_ptr) };
+        // P5 invariant — sqlite3_sql returns the prepare-time template,
+        // bound parameters are `?N` placeholders, not literal values.
+        cstr.to_string_lossy().into_owned()
+    };
+    slot.diag.record_slow(template, cost_ms, slot.queue);
+    0
+}
