+#define MX_REASON_DROP_PARKED                     3200
+
+// ─── REASON_PUSH_REG      (3300-3399)  ·  PushRegResState ──────────────────
+#define MX_REASON_PUSH_REG_UNKNOWN                3300
+#define MX_REASON_PUSH_REG_OK                     3301
+#define MX_REASON_PUSH_REG_PLAIN                  3302
+#define MX_REASON_PUSH_REG_ALTCERT                3303
+#define MX_REASON_PUSH_REG_RID_MISMATCH           3304
