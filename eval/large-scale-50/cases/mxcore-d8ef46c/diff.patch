+// ─────────────────────────────────────────────────────────────────────
+//   Tests
+// ─────────────────────────────────────────────────────────────────────
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::Mutex as StdMutex;
+
+    fn tempdir() -> PathBuf {
+        let mut d = std::env::temp_dir();
+        d.push(format!(
+            "mxcore-diag-{}-{:p}",
+            std::process::id(),
+            &SLOW_QUERY_THRESHOLD_MS
+        ));
+        std::fs::create_dir_all(&d).unwrap();
+        d
+    }
+
+    fn capture_sink() -> (EventSink, Arc<StdMutex<Vec<StorageEvent>>>) {
+        let buf: Arc<StdMutex<Vec<StorageEvent>>> = Arc::new(StdMutex::new(Vec::new()));
+        let buf_cb = Arc::clone(&buf);
+        let sink: EventSink = Arc::new(move |e| buf_cb.lock().unwrap().push(e));
+        (sink, buf)
+    }
+
+    #[test]
+    fn lock_path_appends_lock_suffix() {
+        let p = Path::new("/tmp/foo/bar.db");
+        assert_eq!(
+            FileLock::lock_path_for(p),
+            PathBuf::from("/tmp/foo/bar.db.lock")
+        );
+    }
+
+    #[test]
+    fn lock_path_when_db_path_has_no_filename() {
+        // Pathological — should still produce a usable lock path. We
+        // accept "/.lock" rather than panic.
+        let p = Path::new("/");
+        let lp = FileLock::lock_path_for(p);
+        assert!(lp.to_string_lossy().ends_with(".lock"));
+    }
+
+    #[test]
+    fn acquire_exclusive_succeeds_when_uncontended() {
+        let dir = tempdir();
+        let db = dir.join("ok.db");
+        let diag = SharedDiag::new("test/ok.db".into(), None);
+        let lock = FileLock::open(&db, diag).unwrap();
+        let g = lock.acquire_exclusive(DEFAULT_LOCK_TIMEOUT).unwrap();
+        drop(g);
+    }
+
+    #[test]
+    fn lock_file_is_created_next_to_db() {
+        let dir = tempdir();
+        let db = dir.join("create.db");
+        let diag = SharedDiag::new("test/create.db".into(), None);
+        let _lock = FileLock::open(&db, diag).unwrap();
+        let lock_file = db.with_file_name("create.db.lock");
+        assert!(lock_file.exists(), "expected {lock_file:?} to be created");
+    }
+
+    #[test]
+    fn acquire_exclusive_times_out_emits_lock_timeout() {
+        // Same process, two different fds on the same lock file: the
+        // second one's try_lock_exclusive will return WouldBlock until
+        // the first releases — exactly the cross-process scenario, just
+        // simulated within one process.
+        let dir = tempdir();
+        let db = dir.join("timeout.db");
+        let (sink, buf) = capture_sink();
+        let diag_a = SharedDiag::new("t/timeout.db".into(), None);
+        let diag_b = SharedDiag::new("t/timeout.db".into(), Some(sink));
+        let a = FileLock::open(&db, diag_a).unwrap();
+        let b = FileLock::open(&db, diag_b).unwrap();
+
+        let g = a.acquire_exclusive(DEFAULT_LOCK_TIMEOUT).unwrap();
+        let err = b.acquire_exclusive(Duration::from_millis(700)).unwrap_err();
+        match err {
+            Error::LockTimeout { waited_ms } => {
+                assert!(waited_ms >= 600, "waited_ms too small: {waited_ms}");
+            }
+            other => panic!("expected LockTimeout, got {other:?}"),
+        }
+        drop(g);
+
+        let events = buf.lock().unwrap();
+        let saw_wait = events.iter().any(|e| {
+            matches!(
+                e,
+                StorageEvent::LockWait {
+                    exclusive: true,
+                    ..
+                }
+            )
+        });
+        let saw_timeout = events.iter().any(|e| {
+            matches!(
+                e,
+                StorageEvent::LockTimeout {
+                    exclusive: true,
+                    ..
+                }
+            )
+        });
+        assert!(saw_wait, "no LockWait emitted: {events:?}");
+        assert!(saw_timeout, "no LockTimeout emitted: {events:?}");
+    }
+
+    #[test]
+    fn slow_query_dedupe_swallows_repeats_within_window() {
+        let (sink, buf) = capture_sink();
+        let diag = SharedDiag::new("t/x.db".into(), Some(sink));
+        diag.record_slow("SELECT 1".into(), 600, QueueKind::MainRead);
+        diag.record_slow("SELECT 1".into(), 700, QueueKind::MainRead);
+        diag.record_slow("SELECT 1".into(), 800, QueueKind::MainRead);
+        let events = buf.lock().unwrap();
+        assert_eq!(events.len(), 1, "expected single emit, got {events:?}");
+    }
+
+    #[test]
+    fn slow_query_below_threshold_is_silent() {
+        let (sink, buf) = capture_sink();
+        let diag = SharedDiag::new("t/x.db".into(), Some(sink));
+        diag.record_slow("SELECT 1".into(), 100, QueueKind::MainRead);
+        diag.record_slow("SELECT 1".into(), 499, QueueKind::MainRead);
+        assert!(buf.lock().unwrap().is_empty());
+    }
+
+    #[test]
+    fn slow_query_carries_queue_kind() {
+        let (sink, buf) = capture_sink();
+        let diag = SharedDiag::new("t/x.db".into(), Some(sink));
+        diag.record_slow("SELECT a".into(), 600, QueueKind::Write);
+        diag.record_slow("SELECT b".into(), 600, QueueKind::BackRead);
+        let events = buf.lock().unwrap();
+        assert_eq!(events.len(), 2);
+        match &events[0] {
+            StorageEvent::SlowQuery { queue, .. } => assert_eq!(*queue, QueueKind::Write),
+            _ => panic!(),
+        }
+        match &events[1] {
+            StorageEvent::SlowQuery { queue, .. } => assert_eq!(*queue, QueueKind::BackRead),
+            _ => panic!(),
+        }
+    }
+
+    #[test]
+    fn wal_hook_install_uninstall_round_trip() {
+        // Smoke test: install + uninstall on a real connection shouldn't
+        // leak / crash. Full checkpoint-failure path needs an actual WAL
+        // workload and a forced corruption — covered by pool integration
+        // tests, not here.
+        let dir = tempdir();
+        let db = dir.join("wal.db");
+        let conn = Connection::open(&db).unwrap();
+        conn.pragma_update(None, "journal_mode", "WAL").unwrap();
+        let diag = SharedDiag::new("t/wal.db".into(), None);
+        unsafe {
+            let raw = install_wal_hook(&conn, Arc::clone(&diag));
+            assert!(!raw.is_null());
+            uninstall_wal_hook(&conn, raw);
+        }
+    }
+
+    #[test]
+    fn slow_query_profile_install_uninstall_round_trip() {
+        let dir = tempdir();
+        let db = dir.join("prof.db");
+        let conn = Connection::open(&db).unwrap();
+        let diag = SharedDiag::new("t/prof.db".into(), None);
+        unsafe {
+            let raw = install_slow_query_profile(&conn, Arc::clone(&diag), QueueKind::Write);
+            assert!(!raw.is_null());
+            uninstall_slow_query_profile(&conn, raw);
+        }
+    }
+}
