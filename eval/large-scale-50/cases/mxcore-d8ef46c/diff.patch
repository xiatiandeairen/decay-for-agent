--- a/bindings/electron/__tests__/frame.test.ts
+++ /dev/null
@@ -1,68 +0,0 @@
-import { describe, it, expect } from 'vitest';
-import { IKey, decodePushFrame } from '../';
-import * as zlib from 'node:zlib';
-
-const KEY = Buffer.alloc(32, 0x42);
-const UID = '971109976940436252';
-
-// Wire format (per crates/platform/core-protocol/src/frame.rs +
-// crates/core-ffi/src/ingest.rs::test_helpers::build_bundle):
-//   frame = [flags u16 BE][seq? u16 BE][ack? u16 BE][zip-section][magic u16 BE = 0x270F]
-//   zip-section (plain) = raw-DEFLATE(bundle), no zlib header
-//   bundle = [body_len u32 BE][body]
-//   body = concat of per-msg blocks:
-//          [msg_len u32 BE][payload_len u32 BE][payload][extra_len u32 BE][extra]
-//          (extra_len = 0 → no extra)
-//   flags top 4 bits = version (3); NEED_ACK = 0x0001, ENCRYPTED = 0x0002.
-function u16be(n: number): Buffer { const b = Buffer.alloc(2); b.writeUInt16BE(n, 0); return b; }
-function u32be(n: number): Buffer { const b = Buffer.alloc(4); b.writeUInt32BE(n, 0); return b; }
-
-function buildBundle(messages: { payload: Buffer; extra?: Buffer }[]): Buffer {
-  const blocks: Buffer[] = [];
-  for (const m of messages) {
-    const extraLen = m.extra ? m.extra.length : 0;
-    const msg = Buffer.concat([
-      u32be(m.payload.length),
-      m.payload,
-      u32be(extraLen),
-      m.extra ?? Buffer.alloc(0),
-    ]);
-    blocks.push(u32be(msg.length));
-    blocks.push(msg);
-  }
-  const body = Buffer.concat(blocks);
-  return Buffer.concat([u32be(body.length), body]);
-}
-
-function buildPlainFrame(payload: Buffer, seqId: number): Buffer {
-  const bundle = buildBundle([{ payload }]);
-  const zip = zlib.deflateRawSync(bundle);
-  const flags = (3 << 12) | (1 << 1);           // version=3, NEED_ACK (bit 1)
-  return Buffer.concat([
-    u16be(flags),
-    u16be(seqId),
-    zip,
-    u16be(0x270F),                              // trailing magic
-  ]);
-}
-
-describe('decodePushFrame', () => {
-  it('decodes a plain single-message frame', () => {
-    const k = new IKey(KEY, UID);
-    const payload = Buffer.from('{"c":"HyperText","f":"abc","tenantId":"t1"}');
-    const frame = buildPlainFrame(payload, 0x0042);
-
-    const out = decodePushFrame(frame, k);
-
-    expect(out.seqId).toBe(0x0042);
-    expect(out.ackId == null).toBe(true);
-    expect(out.messages).toHaveLength(1);
-    expect(out.messages[0].payloadJson).toEqual(payload);
-    expect(out.messages[0].extra == null).toBe(true);
-  });
-
-  it('rejects too-short frame', () => {
-    const k = new IKey(KEY, UID);
-    expect(() => decodePushFrame(Buffer.from([0x00]), k)).toThrow(/MX_ERR_INVALID_INPUT/);
-  });
-});
