diff --git a/bindings/electron/Cargo.toml b/bindings/electron/Cargo.toml
deleted file mode 100644
index efb3213..0000000
--- a/bindings/electron/Cargo.toml
+++ /dev/null
@@ -1,50 +0,0 @@
-# Empty `[workspace]` makes this a standalone cargo project (NOT a member
-# of the mxcore Cargo workspace at the repo root). Plan docs/superpowers/
-# specs/2026-05-04-mxcore-electron-napi-binding-design.md §4.1 mandates
-# this isolation so `cargo test` from the repo root does not build the
-# binding crate (keeping the Phase 1 default-members fast).
-[workspace]
-
-[package]
-name    = "mxcore-electron"
-version = "0.0.0"
-edition = "2021"
-publish = false
-
-[lib]
-crate-type = ["cdylib"]
-
-[dependencies]
-core-ffi       = { path = "../../crates/core-ffi" }
-core-context   = { path = "../../crates/shared/core-context" }
-core-push      = { path = "../../crates/core-push" }
-core-crypto    = { path = "../../crates/shared/core-crypto" }
-core-net       = { path = "../../crates/shared/core-net" }
-core-protocol  = { path = "../../crates/shared/core-protocol" }
-# Required for SupervisorSignal::SendWithCallback.body which is `bytes::Bytes`.
-# Pin to the same version core-push pulls in (workspace dep) to avoid two
-# `bytes` versions linked into the cdylib.
-bytes          = "1"
-napi           = { version = "2", default-features = false, features = ["napi6", "tokio_rt"] }
-napi-derive    = "2"
-serde_json     = "1"
-# Inlined from top-level Cargo.toml [workspace.dependencies] (this crate is
-# intentionally NOT in the workspace `members` list, so `tokio.workspace = true`
-# would not resolve). Keep features in sync with workspace tokio.
-tokio = { version = "1.42", default-features = false, features = [
-    "rt",
-    "rt-multi-thread",
-    "net",
-    "sync",
-    "time",
-    "macros",
-    "io-util",
-] }
-
-[build-dependencies]
-napi-build = "2"
-
-[profile.release]
-lto = true
-opt-level = "s"
-strip = "debuginfo"
diff --git a/bindings/electron/README.md b/bindings/electron/README.md
deleted file mode 100644
index 29696bc..0000000
--- a/bindings/electron/README.md
+++ /dev/null
@@ -1,25 +0,0 @@
-# @mxcore/native — Electron / Node.js binding for mxcore
-
-napi-rs binding exposing IKey crypto, push-frame decoding, AppContext +
-ServerClock, and PushTransport.
-
-## Build
-
-Requires Rust 1.83+ (per workspace `rust-toolchain.toml`) and Node 18+.
-
-```sh
-npm install
-npm run build              # release, host triple
-npm run build:debug
-npm test
-```
-
-Cross-compile is not supported. Build the Win64 .node on a Windows host
-and the macOS arm64 .node on an Apple Silicon host.
-
-## Standalone cargo project
-
-This crate is intentionally NOT in the workspace `members` list. It is
-built by `napi build` (which invokes `cargo build` with the right target
-triple) and tested by `vitest`. The mxcore workspace `cargo test` does
-not build this crate.
