-//! `TransportEvent` → JS-shaped payload (name + JSON-friendly object).
-
-use core_transport::event::{DisconnectReason, DropReason, TransportEvent};
-use core_transport::policy::{FailedReason, PushState};
-use napi::bindgen_prelude::Buffer;
-use serde_json::{json, Value};
