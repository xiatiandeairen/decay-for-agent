+        let pool = Pool::open(&PoolConfig::file(&path).with_event_sink(sink)).unwrap();
+        let _ = pool.observe_sqlite_err(rusqlite::Error::SqliteFailure(
+            rusqlite::ffi::Error::new(26),
+            None,
+        ));
+        let n = captured
+            .lock()
+            .unwrap()
+            .iter()
+            .filter(|e| {
+                matches!(
+                    e,
+                    StorageEvent::Corrupted {
+                        sqlite_code: 26,
+                        ..
+                    }
+                )
+            })
+            .count();
+        assert_eq!(n, 1);
+    }
+
+    #[test]
+    fn non_corruption_errors_do_not_emit_corrupted_event() {
+        let path = temp_db("constraint_no_emit");
+        let captured: Arc<StdMutex<Vec<StorageEvent>>> = Arc::new(StdMutex::new(Vec::new()));
+        let cap_cb = Arc::clone(&captured);
+        let sink = Arc::new(move |e: StorageEvent| cap_cb.lock().unwrap().push(e));
+        let pool = Pool::open(&PoolConfig::file(&path).with_event_sink(sink)).unwrap();
+        // SQLITE_CONSTRAINT = 19, should NOT fire Corrupted.
+        let _ = pool.observe_sqlite_err(rusqlite::Error::SqliteFailure(
+            rusqlite::ffi::Error::new(19),
+            None,
+        ));
+        let events = captured.lock().unwrap();
+        assert!(events
+            .iter()
+            .all(|e| !matches!(e, StorageEvent::Corrupted { .. })));
+    }
+
+    #[test]
+    fn pool_db_path_rel_overrides_default() {
+        let path = temp_db("pathrel");
+        let captured: Arc<StdMutex<Vec<StorageEvent>>> = Arc::new(StdMutex::new(Vec::new()));
+        let cap_cb = Arc::clone(&captured);
+        let sink = Arc::new(move |e: StorageEvent| cap_cb.lock().unwrap().push(e));
+        let pool = Pool::open(
+            &PoolConfig::file(&path)
+                .with_event_sink(sink)
+                .with_db_path_rel("ws_personal/main.db"),
+        )
+        .unwrap();
+        let _ = pool.observe_sqlite_err(rusqlite::Error::SqliteFailure(
+            rusqlite::ffi::Error::new(11),
+            None,
+        ));
+        let events = captured.lock().unwrap();
+        let first = events.first().expect("expected at least one event");
+        match first {
+            StorageEvent::Corrupted { db_path, .. } => {
+                assert_eq!(db_path, "ws_personal/main.db");
+            }
+            other => panic!("expected Corrupted, got {other:?}"),
+        }
+    }
 }
