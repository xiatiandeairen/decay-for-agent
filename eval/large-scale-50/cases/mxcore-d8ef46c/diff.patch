-//! Synchronous return-value bridge over `napi::ThreadsafeFunction`.
-//!
-//! mxcore's supervisor calls `RegisterContext::rng_fn` synchronously
-//! from a tokio worker thread. JS callbacks live on the V8 main thread.
-//! We use `ThreadsafeFunction::call_with_return_value` plus a
-//! `std::sync::mpsc::sync_channel` to round-trip the JS return value
-//! into the worker thread without `block_on`-on-V8 (which would
-//! deadlock).
-//!
-//! Timeout is 5s — matching `core_push::register::DEFAULT_HANDSHAKE_TIMEOUT`.
-//! On timeout the rng bridge returns an empty `Vec<u8>`; downstream
-//! `RegisterContext::rng_fn` leaves the buffer zero-filled and the
-//! supervisor produces a malformed PushReg the server will reject.
-//!
-//! After the D6 reversal (CLAUDE.md `core-context-app-context-server-clock`
-//! spec §12.14) the PushReg `info` callback was removed — identity is
-//! sourced from `AppContext` directly, so this module no longer carries
-//! `InfoCallback` / `PushRegInfoJs` / `js_to_pushreg` helpers.
-
-use napi::bindgen_prelude::*;
-use napi::threadsafe_function::{
-    ErrorStrategy, ThreadsafeFunction, ThreadsafeFunctionCallMode,
-};
-use std::sync::mpsc::sync_channel;
-use std::time::Duration;
-
-const SYNC_CALLBACK_TIMEOUT: Duration = Duration::from_secs(5);
-
-/// `(num_bytes: u32) => Buffer` — JS supplies cryptographic randomness.
-pub type RngCallback = ThreadsafeFunction<u32, ErrorStrategy::Fatal>;
-
-pub fn call_rng_sync(tsfn: &RngCallback, n: u32) -> Vec<u8> {
-    let (tx, rx) = sync_channel::<Vec<u8>>(0);
-    let status = tsfn.call_with_return_value(
-        n,
-        ThreadsafeFunctionCallMode::Blocking,
-        move |buf: Buffer| {
-            let _ = tx.send(buf.to_vec());
-            Ok(())
-        },
-    );
-    if status != Status::Ok {
-        return Vec::new();
-    }
-    rx.recv_timeout(SYNC_CALLBACK_TIMEOUT).unwrap_or_default()
-}
