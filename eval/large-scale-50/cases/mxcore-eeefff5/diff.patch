@@ -0,0 +1,235 @@
+use std::net::SocketAddr;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::Arc;
+use std::time::Duration;
+
+use core_context::{AppContext, AppInfo, ClientType, DeviceInfo, LocaleSettings};
+use core_http::{
+    AuthPolicy, Body, CommonParams, ContentType, Endpoint, EndpointConfig, Error, HttpClient,
+    HttpConfig, Method, PinConfig, QueryParams, SigningPolicy,
+};
+use core_types::{MxErrorCode, ToErrorCode};
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::TcpListener;
+
+type TestOutput = std::collections::BTreeMap<String, bool>;
+
+struct MissingMappingEndpoint;
+
+impl Endpoint for MissingMappingEndpoint {
+    type Output = TestOutput;
+
+    const NAME: &'static str = "missing_mapping";
+    const METHOD: Method = Method::Get;
+    const PATH: &'static str = "/unknown/path";
+    const AUTH_POLICY: AuthPolicy = AuthPolicy::None;
+}
+
+struct BadPathEndpoint;
+
+impl Endpoint for BadPathEndpoint {
+    type Output = TestOutput;
+
+    const NAME: &'static str = "bad_path";
+    const METHOD: Method = Method::Get;
+    const PATH: &'static str = "bad/path";
+    const AUTH_POLICY: AuthPolicy = AuthPolicy::None;
+}
+
+struct SigningEndpoint;
+
+impl Endpoint for SigningEndpoint {
+    type Output = TestOutput;
+
+    const NAME: &'static str = "signing";
+    const METHOD: Method = Method::Get;
+    const PATH: &'static str = "/api/signing";
+}
+
+struct NoAuthEndpoint;
+
+impl Endpoint for NoAuthEndpoint {
+    type Output = TestOutput;
+
+    const NAME: &'static str = "no_auth";
+    const METHOD: Method = Method::Get;
+    const PATH: &'static str = "/api/test";
+    const AUTH_POLICY: AuthPolicy = AuthPolicy::None;
+    const CONTENT_TYPE: ContentType = ContentType::Json;
+    const COMMON_PARAMS: CommonParams = CommonParams::Disabled;
+    const SIGNING_POLICY: SigningPolicy = SigningPolicy::Disabled;
+
+    fn query(&self) -> QueryParams {
+        QueryParams::default()
+    }
+
+    fn body(&self) -> Body {
+        Body::Empty
+    }
+}
+
+fn app_context() -> Arc<AppContext> {
+    Arc::new(
+        AppContext::builder()
+            .app_info(AppInfo::new(ClientType::Mac, "1.0.0", "com.matrx.test", "0.0.0").unwrap())
+            .device_info(DeviceInfo::new("did-1", "14.0", "Apple", "MacBookPro", "Mac").unwrap())
+            .environment_label("test")
+            .initial_locale(LocaleSettings::new("en-US", "en-US,en", "US"))
+            .build()
+            .unwrap(),
+    )
+}
+
+fn http_client(endpoint: EndpointConfig) -> HttpClient {
+    HttpClient::new(
+        app_context(),
+        Arc::new(HttpConfig::new(endpoint, PinConfig::empty())),
+    )
+}
+
+fn endpoint_config(base_url: String) -> EndpointConfig {
+    EndpointConfig::new([("/api", base_url)], None).unwrap()
+}
+
+async fn mock_response(status: u16, body: &'static str) -> String {
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    tokio::spawn(async move {
+        let (mut stream, _) = listener.accept().await.unwrap();
+        let mut request_buf = [0_u8; 1024];
+        let _ = stream.read(&mut request_buf).await;
+        let response = format!(
+            "HTTP/1.1 {status} test\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}",
+            body.len()
+        );
+        stream.write_all(response.as_bytes()).await.unwrap();
+    });
+    format!("http://{addr}")
+}
+
+async fn mock_responses(responses: Vec<(u16, &'static str)>) -> (String, Arc<AtomicUsize>) {
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    let requests = Arc::new(AtomicUsize::new(0));
+    let seen = requests.clone();
+    tokio::spawn(async move {
+        for (status, body) in responses {
+            let (mut stream, _) = listener.accept().await.unwrap();
+            seen.fetch_add(1, Ordering::SeqCst);
+            let mut request_buf = [0_u8; 1024];
+            let _ = stream.read(&mut request_buf).await;
+            let response = format!(
+                "HTTP/1.1 {status} test\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}",
+                body.len()
+            );
+            stream.write_all(response.as_bytes()).await.unwrap();
+        }
+    });
+    (format!("http://{addr}"), requests)
+}
+
+async fn advance_default_retry_delays() {
+    for delay in [
+        Duration::from_millis(500),
+        Duration::from_secs(1),
+        Duration::from_secs(2),
+    ] {
+        tokio::task::yield_now().await;
+        tokio::time::advance(delay).await;
+    }
+}
+
+fn unused_local_url() -> String {
+    let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+    let addr: SocketAddr = listener.local_addr().unwrap();
+    drop(listener);
+    format!("http://{addr}")
+}
+
+#[tokio::test]
+async fn missing_endpoint_mapping_maps_to_http_invalid_config() {
+    let client = http_client(EndpointConfig::empty());
+    let err = client.send(MissingMappingEndpoint).await.unwrap_err();
+    assert_eq!(err.error_code(), MxErrorCode::HttpInvalidConfig);
+}
+
+#[tokio::test]
+async fn invalid_endpoint_path_maps_to_http_invalid_request() {
+    let client = http_client(endpoint_config("http://127.0.0.1:1".to_string()));
+    let err = client.send(BadPathEndpoint).await.unwrap_err();
+    assert_eq!(err.error_code(), MxErrorCode::HttpInvalidRequest);
+}
+
+#[tokio::test]
+async fn missing_ikey_maps_to_http_signing_failed() {
+    let client = http_client(endpoint_config("http://127.0.0.1:1".to_string()));
+    let err = client.send(SigningEndpoint).await.unwrap_err();
+    assert_eq!(err.error_code(), MxErrorCode::HttpSigningFailed);
+}
+
+#[tokio::test]
+async fn non_json_response_maps_to_http_invalid_response() {
+    let base_url = mock_response(200, "not-json").await;
+    let client = http_client(endpoint_config(base_url));
+    let err = client.send(NoAuthEndpoint).await.unwrap_err();
+    assert_eq!(err.error_code(), MxErrorCode::HttpInvalidResponse);
+}
+
+#[tokio::test(start_paused = true)]
+async fn non_success_status_maps_to_http_server_error() {
+    let (base_url, requests) = mock_responses(vec![
+        (500, r#"{"responseHeader":{"status":500,"msg":"boom"}}"#),
+        (500, r#"{"responseHeader":{"status":500,"msg":"boom"}}"#),
+        (500, r#"{"responseHeader":{"status":500,"msg":"boom"}}"#),
+        (500, r#"{"responseHeader":{"status":500,"msg":"boom"}}"#),
+    ])
+    .await;
+    let client = http_client(endpoint_config(base_url));
+    let send = tokio::spawn(async move { client.send(NoAuthEndpoint).await });
+    advance_default_retry_delays().await;
+    let err = send.await.unwrap().unwrap_err();
+    assert_eq!(err.error_code(), MxErrorCode::HttpServerError);
+    assert_eq!(requests.load(Ordering::SeqCst), 4);
+}
+
+#[tokio::test(start_paused = true)]
+async fn refused_connection_maps_to_net_connect_failed() {
+    let client = http_client(endpoint_config(unused_local_url()));
+    let send = tokio::spawn(async move { client.send(NoAuthEndpoint).await });
+    advance_default_retry_delays().await;
+    let err = send.await.unwrap().unwrap_err();
+    assert!(matches!(err, Error::Network(_)));
+    assert_eq!(err.error_code(), MxErrorCode::NetConnectFailed);
+}
+
+#[tokio::test(start_paused = true)]
+async fn five_xx_retries_then_success() {
+    let (base_url, requests) = mock_responses(vec![
+        (500, r#"{"responseHeader":{"status":500,"msg":"boom"}}"#),
+        (
+            502,
+            r#"{"responseHeader":{"status":502,"msg":"bad gateway"}}"#,
+        ),
+        (200, r#"{"response":{"ok":true}}"#),
+    ])
+    .await;
+    let client = http_client(endpoint_config(base_url));
+    let send = tokio::spawn(async move { client.send(NoAuthEndpoint).await });
+    advance_default_retry_delays().await;
+    let response = send.await.unwrap().unwrap();
+    assert_eq!(response.into_inner().get("ok"), Some(&true));
+    assert_eq!(requests.load(Ordering::SeqCst), 3);
+}
+
+#[tokio::test]
+async fn four_xx_does_not_retry() {
+    let (base_url, requests) = mock_responses(vec![(
+        400,
+        r#"{"responseHeader":{"status":400,"msg":"bad"}}"#,
+    )])
+    .await;
+    let client = http_client(endpoint_config(base_url));
+    let err = client.send(NoAuthEndpoint).await.unwrap_err();
+    assert_eq!(err.error_code(), MxErrorCode::HttpServerError);
+    assert_eq!(requests.load(Ordering::SeqCst), 1);
+}
