+impl ToErrorCode for Error {
+    fn error_code(&self) -> MxErrorCode {
+        match self {
+            Self::InvalidConfig(_) => MxErrorCode::HttpInvalidConfig,
+            Self::InvalidRequest(_) => MxErrorCode::HttpInvalidRequest,
+            Self::Signing(_) => MxErrorCode::HttpSigningFailed,
+            Self::Network(err) => network_error_code(err),
+            Self::InvalidResponse(_) => MxErrorCode::HttpInvalidResponse,
+            Self::Server { .. } => MxErrorCode::HttpServerError,
+        }
+    }
+}
+
+fn network_error_code(err: &reqwest::Error) -> MxErrorCode {
+    if err.is_timeout() {
+        MxErrorCode::NetTimeout
+    } else if err.is_connect() {
+        MxErrorCode::NetConnectFailed
+    } else if err.is_body() {
+        MxErrorCode::NetBodyReadFailed
+    } else {
+        MxErrorCode::NetRequestFailed
+    }
+}
+
 impl From<reqwest::Error> for Error {
     fn from(value: reqwest::Error) -> Self {
         Self::Network(value)
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn http_error_codes_are_leaf_mapped() {
+        assert_eq!(
+            Error::InvalidConfig("x".to_string()).error_code(),
+            MxErrorCode::HttpInvalidConfig
+        );
+        assert_eq!(
+            Error::InvalidRequest("x".to_string()).error_code(),
+            MxErrorCode::HttpInvalidRequest
+        );
+        assert_eq!(
+            Error::Signing("x".to_string()).error_code(),
+            MxErrorCode::HttpSigningFailed
+        );
+        assert_eq!(
+            Error::InvalidResponse("x".to_string()).error_code(),
+            MxErrorCode::HttpInvalidResponse
+        );
+        assert_eq!(
+            Error::Server {
+                status: 500,
+                message: "server failed".to_string(),
+                body: Box::new(Value::Null),
+                metadata: Box::new(ResponseMetadata {
+                    status_code: 500,
+                    trace: crate::HttpTrace {
+                        endpoint: "test",
+                        method: crate::Method::Get,
+                        path: "/test".to_string(),
+                        signing_input_hash: String::new(),
+                        signing_input_len: 0,
+                        token_hash: String::new(),
+                    },
+                }),
+            }
+            .error_code(),
+            MxErrorCode::HttpServerError
+        );
+    }
+}
