+#[derive(Debug, Clone, Copy)]
+struct RetryPolicy {
+    max_retries: u32,
+    initial_delay: Duration,
+    max_delay: Duration,
+    jitter_pct: u8,
+}
+
+impl RetryPolicy {
+    fn can_retry(self, attempt: u32) -> bool {
+        attempt < self.max_retries
+    }
+
+    fn backoff(self) -> ExpBackoff {
+        ExpBackoff::new(self.initial_delay, self.max_delay, self.jitter_pct)
+    }
+}
+
+impl Default for RetryPolicy {
+    fn default() -> Self {
+        Self {
+            max_retries: 3,
+            initial_delay: Duration::from_millis(500),
+            max_delay: Duration::from_secs(8),
+            jitter_pct: 0,
+        }
+    }
+}
+
+async fn sleep_next_retry(backoff: &mut ExpBackoff, rng: &mut impl FnMut() -> u32) {
+    tokio::time::sleep(backoff.next_delay(rng)).await;
+}
+
+fn is_retryable_status(status_code: u16) -> bool {
+    (500..600).contains(&status_code)
+}
