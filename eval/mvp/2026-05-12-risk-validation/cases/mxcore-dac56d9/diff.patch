--- /dev/null
+++ b/crates/core-http/src/tls.rs
@@ -0,0 +1,125 @@
+use std::sync::Arc;
+use std::time::SystemTime;
+
+use rustls::client::{ServerCertVerified, ServerCertVerifier, ServerName, WebPkiVerifier};
+use rustls::{Certificate, CertificateError, ClientConfig, Error, OwnedTrustAnchor, RootCertStore};
+
+use crate::{HostVerdict, HttpConfig};
+
+pub(crate) fn reqwest_client(http_config: Arc<HttpConfig>) -> reqwest::Client {
+    reqwest::Client::builder()
+        .use_preconfigured_tls(client_config(http_config))
+        .build()
+        .expect("core-http rustls client config must be valid")
+}
+
+fn client_config(http_config: Arc<HttpConfig>) -> ClientConfig {
+    let mut cfg = ClientConfig::builder()
+        .with_safe_defaults()
+        .with_custom_certificate_verifier(Arc::new(MxServerCertVerifier::new(http_config)))
+        .with_no_client_auth();
+
+    // reqwest does not mutate preconfigured rustls configs; preserve the
+    // default h2/http1 ALPN behavior when supplying our custom verifier.
+    cfg.alpn_protocols = vec![b"h2".to_vec(), b"http/1.1".to_vec()];
+    cfg
+}
+
+struct MxServerCertVerifier {
+    http_config: Arc<HttpConfig>,
+    os_trust: WebPkiVerifier,
+}
+
+impl MxServerCertVerifier {
+    fn new(http_config: Arc<HttpConfig>) -> Self {
+        Self {
+            http_config,
+            os_trust: WebPkiVerifier::new(os_root_store(), None),
+        }
+    }
+
+    fn verify_pinned_chain(
+        &self,
+        anchors: Vec<Vec<u8>>,
+        end_entity: &Certificate,
+        intermediates: &[Certificate],
+        server_name: &ServerName,
+        scts: &mut dyn Iterator<Item = &[u8]>,
+        ocsp_response: &[u8],
+        now: SystemTime,
+    ) -> Result<ServerCertVerified, Error> {
+        let mut roots = RootCertStore::empty();
+        for anchor in anchors {
+            roots.add(&Certificate(anchor))?;
+        }
+
+        // Trust-anchor pinning: this RootCertStore contains only the
+        // configured DER anchors for the host, so webpki can validate
+        // the server chain only if it terminates at one of those pins.
+        // Unlike SecTrust, rustls does not expose the built chain's root
+        // certificate here; requiring the peer to send the root would
+        // reject normal servers that omit trust anchors from TLS chains.
+        WebPkiVerifier::new(roots, None).verify_server_cert(
+            end_entity,
+            intermediates,
+            server_name,
+            scts,
+            ocsp_response,
+            now,
+        )
+    }
+}
+
+impl ServerCertVerifier for MxServerCertVerifier {
+    fn verify_server_cert(
+        &self,
+        end_entity: &Certificate,
+        intermediates: &[Certificate],
+        server_name: &ServerName,
+        scts: &mut dyn Iterator<Item = &[u8]>,
+        ocsp_response: &[u8],
+        now: SystemTime,
+    ) -> Result<ServerCertVerified, Error> {
+        let host = server_name_to_host(server_name);
+        match self.http_config.pin.load().host_verdict(&host) {
+            HostVerdict::Pinned(anchors) => self.verify_pinned_chain(
+                anchors,
+                end_entity,
+                intermediates,
+                server_name,
+                scts,
+                ocsp_response,
+                now,
+            ),
+            HostVerdict::UseOsTrust => self.os_trust.verify_server_cert(
+                end_entity,
+                intermediates,
+                server_name,
+                scts,
+                ocsp_response,
+                now,
+            ),
+            HostVerdict::Reject => Err(CertificateError::ApplicationVerificationFailure.into()),
+        }
+    }
+}
+
+fn server_name_to_host(server_name: &ServerName) -> String {
+    match server_name {
+        ServerName::DnsName(name) => name.as_ref().to_string(),
+        ServerName::IpAddress(addr) => addr.to_string(),
+        _ => String::new(),
+    }
+}
+
+fn os_root_store() -> RootCertStore {
+    let mut roots = RootCertStore::empty();
+    roots.add_trust_anchors(webpki_roots::TLS_SERVER_ROOTS.iter().map(|anchor| {
+        OwnedTrustAnchor::from_subject_spki_name_constraints(
+            anchor.subject,
+            anchor.spki,
+            anchor.name_constraints,
+        )
+    }));
+    roots
+}
